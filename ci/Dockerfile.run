# Runtime image for blur-cli
#
# Requires the CI builder image to already be built:
#   docker build -t blur-linux -f ci/Dockerfile .
#
# Then build this runtime image:
#   docker build -t blur-run -f ci/Dockerfile.run .
#
# Run:
#   docker run --rm --gpus all \
#     -v /path/to/videos:/input \
#     -v /path/to/output:/output \
#     -v /path/to/config:/config \
#     blur-run \
#     -i /input/video.mp4 -o /output/video.mp4 -c /config/blur.cfg

# Pull the pre-built bundle from the CI image
FROM blur-linux AS bundle

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Request full NVIDIA driver capabilities (compute + graphics/Vulkan).
# By default --gpus all only mounts compute libs; graphics is needed for RIFE (Vulkan).
ENV NVIDIA_DRIVER_CAPABILITIES=all
# Use the EGL-based NVIDIA Vulkan ICD (headless, no X11 required).
# Set here so all child processes (vspipe) inherit it.
ENV VK_ICD_FILENAMES=/usr/share/vulkan/icd.d/nvidia_icd.json

# libvulkan1  — Vulkan loader (ICD); the actual NVIDIA Vulkan ICD is injected by
#               the NVIDIA Container Toolkit at runtime via --gpus all.
# ca-certificates — needed by blur for update checks (can skip with no network)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libvulkan1 \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Bake in the NVIDIA Vulkan ICD descriptor.
# NVIDIA_DRIVER_CAPABILITIES=all makes nvidia-container-toolkit mount libGLX_nvidia.so.0
# but does NOT create nvidia_icd.json. The Vulkan loader needs this file to discover
# the NVIDIA driver. libGLX_nvidia.so.0 uses a relative path so ldconfig finds it from
# /usr/lib/x86_64-linux-gnu/ where nvidia-container-toolkit places it.
# Use libEGL_nvidia.so.0 as the Vulkan ICD — it supports headless Vulkan without X11.
# libGLX_nvidia.so.0 (the default on the host) requires libX11/libXext which are
# absent in headless containers.
RUN mkdir -p /usr/share/vulkan/icd.d && \
    printf '{"file_format_version":"1.0.0","ICD":{"library_path":"libEGL_nvidia.so.0","api_version":"1.3.242"}}\n' \
    > /usr/share/vulkan/icd.d/nvidia_icd.json

# Copy the bundle from the CI build stage
COPY --from=bundle /dist/blur-Linux-Release-x64 /blur

# Declare expected mount points (documentation only — Docker doesn't enforce them)
VOLUME ["/input", "/output", "/config"]

ENTRYPOINT ["/blur/blur-cli"]
CMD ["--help"]
